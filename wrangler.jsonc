{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "nihalgonsalves-com",
	// Waku's build also writes dist/server/wrangler.json and redirects wrangler to
	// it via .wrangler/deploy/config.json, but that copy drops routes, previews
	// etc. Always pass `-c wrangler.jsonc` (see package.json) to use this file.
	"main": "./dist/server/index.js",
	"no_bundle": true,
	"rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
	// https://developers.cloudflare.com/workers/platform/compatibility-dates
	"compatibility_date": "2024-11-11",
	// nodejs_als is required for Waku server-side request context
	// It can be removed if only building static pages
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"routes": [{ "pattern": "nihalgonsalv.es", "custom_domain": true }],
	// https://developers.cloudflare.com/workers/static-assets/binding/
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/public",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
	},
	"previews": {},
}
